@code {
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var qs = new Uri(Nav.Uri).Query;
        var q = System.Web.HttpUtility.ParseQueryString(qs);
        var dateStr = q.Get("date");
        if (!string.IsNullOrEmpty(dateStr) && DateTime.TryParse(dateStr, out var parsed))
        {
            CurrentDate = new DateTime(parsed.Year, parsed.Month, 1);
        }

        var start = GetMonthDays().First();
        var end = GetMonthDays().Last().AddDays(1).AddTicks(-1);
        await LoadEventsForRange(start, end);
    }

    private async Task PrevMonth()
    {
        CurrentDate = CurrentDate.AddMonths(-1);
        var start = GetMonthDays().First();
        var end = GetMonthDays().Last().AddDays(1).AddTicks(-1);
        await LoadEventsForRange(start, end);
        Nav.NavigateTo($"/calendar/month?date={CurrentDate:yyyy-MM-dd}", false);
    }

    private async Task NextMonth()
    {
        CurrentDate = CurrentDate.AddMonths(1);
        var start = GetMonthDays().First();
        var end = GetMonthDays().Last().AddDays(1).AddTicks(-1);
        await LoadEventsForRange(start, end);
        Nav.NavigateTo($"/calendar/month?date={CurrentDate:yyyy-MM-dd}", false);
    }
}

