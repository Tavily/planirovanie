@page "/calendar/month"
@using Microsoft.AspNetCore.Components
@inject NavigationManager Nav
@inherits planirovanie.Components.Scheduler.CalendarBase

<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        @* <div>
            <h2 class="mb-1">Календарь мероприятий</h2>
            <p class="text-muted mb-0">План основных мероприятий, проводимых на территории муниципального образования "Город Волгодонск"</p>
        </div> *@
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" href="/">На главную</a>
            <button class="btn btn-primary" @onclick="OpenCreateDialog">+ Добавить мероприятие</button>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                <div class="btn-group" role="group">
                    <a class="btn btn-outline-dark" href="/calendar/day">День</a>
                    <a class="btn btn-outline-dark" href="/calendar/week">Неделя</a>
                    <a class="btn btn-outline-dark" href="/calendar/month">Месяц</a>
                </div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="badge bg-info text-dark">Режим: Месяц</span>
                    <select class="form-select form-select-sm" style="width: 240px;" @onchange="OnCategoryFilterChanged">
                        <option value="0" selected="@(SelectedCategoryFilter == 0)">Все категории</option>
                        @foreach (var category in Categories)
                        {
                            <option value="@category.Id" selected="@(SelectedCategoryFilter == category.Id)">@category.Name</option>
                        }
                    </select>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="PrevMonth">←</button>
                    <strong class="mx-2 text-capitalize">@CurrentDate.ToString("MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))</strong>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="NextMonth">→</button>
                </div>
            </div>

            <div class="calendar-grid month-view">
                @foreach (var day in GetMonthDays())
                {
                    var cellClasses = "calendar-cell" + (day.Month != CurrentDate.Month ? " muted" : string.Empty) + (IsHoliday(day) ? " holiday" : string.Empty);
                    var dayDate = day.ToString("yyyy-MM-dd");
                    var eventsForDay = GetEventsForDay(day).ToList();
                    <div class="@cellClasses" role="button">
                        <div class="day-header">
                            <a href="@($"/calendar/day?date={dayDate}")" class="day-number text-decoration-none">@day.Day</a>
                            @if (IsPreHoliday(day))
                            {
                                <span class="badge bg-warning text-dark" style="font-size: 0.65rem;">предпраздник</span>
                            }
                        </div>
                        <div class="day-events">
                            @foreach (var evt in eventsForDay.Take(3))
                            {
                                <a class="event-pill" style="border-left: 6px solid @GetCategoryColor(evt.CategoryId); display:block; text-decoration:none; color:inherit;" href="/event/@evt.Id">
                                    @evt.Title
                                </a>
                            }
                            @if (eventsForDay.Count > 3)
                            {
                                <div class="text-muted small text-center">+@(eventsForDay.Count - 3) ещё</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (IsFormOpen)
{
    <div class="modal-backdrop show" @onclick="CloseForm"></div>
    <div class="modal d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(EditingEvent.Id > 0 ? "Редактирование мероприятия" : "Новое мероприятие")</h5>
                    <button type="button" class="btn-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Название мероприятия *</label>
                        <input class="form-control" @bind="EditingEvent.Title" placeholder="Согласно ТЗ" />
                    </div>
                    <div class="row g-2">
                        <div class="mb-3">
                            <label class="form-label">Начало</label>
                            <input class="form-control" type="datetime-local" @bind="EditingEvent.StartDate" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Окончание</label>
                            <input class="form-control" type="datetime-local" @bind="EditingEvent.EndDate" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Категория</label>
                            <select class="form-select" @bind="EditingEvent.CategoryId">
                                @foreach (var category in Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Место проведения</label>
                            <input class="form-control" @bind="EditingEvent.Location" placeholder="Например: Зал заседаний" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Организатор (Кто проводит)</label>
                            <input class="form-control" @bind="EditingEvent.Organizer" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Участники</label>
                            <input class="form-control" @bind="EditingEvent.Participants" placeholder="ФИО через запятую" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Дополнительная информация</label>
                        <textarea class="form-control" rows="3" @bind="EditingEvent.AdditionalInfo"></textarea>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(FormMessage))
                    {
                        <div class="alert alert-danger py-2">@FormMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    @if (EditingEvent.Id > 0)
                    {
                        <button class="btn btn-outline-danger me-auto" @onclick="DeleteCurrentEvent">Удалить</button>
                    }
                    <button class="btn btn-secondary" @onclick="CloseForm">Отмена</button>
                    <button class="btn btn-primary" @onclick="SaveEvent">Сохранить в план</button>
                </div>
            </div>
        </div>
    </div>
}

