@code {
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var qs = new Uri(Nav.Uri).Query;
        var q = System.Web.HttpUtility.ParseQueryString(qs);
        var dateStr = q.Get("date");
        if (!string.IsNullOrEmpty(dateStr) && DateTime.TryParse(dateStr, out var parsed))
        {
            CurrentDate = parsed.Date;
        }

        var start = GetWeekDays().First();
        var end = GetWeekDays().Last().AddDays(1).AddTicks(-1);
        await LoadEventsForRange(start, end);
    }

    private async Task PrevWeek()
    {
        CurrentDate = CurrentDate.AddDays(-7);
        var start = GetWeekDays().First();
        var end = GetWeekDays().Last().AddDays(1).AddTicks(-1);
        await LoadEventsForRange(start, end);
        Nav.NavigateTo($"/calendar/week?date={CurrentDate:yyyy-MM-dd}", false);
    }

    private async Task NextWeek()
    {
        CurrentDate = CurrentDate.AddDays(7);
        var start = GetWeekDays().First();
        var end = GetWeekDays().Last().AddDays(1).AddTicks(-1);
        await LoadEventsForRange(start, end);
        Nav.NavigateTo($"/calendar/week?date={CurrentDate:yyyy-MM-dd}", false);
    }
}

