@page "/calendar/week"
@using System.Globalization
@using Microsoft.AspNetCore.Components
@inject NavigationManager Nav
@inherits planirovanie.Components.Scheduler.CalendarBase

<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        @{
    // Список всех дней недели
    var weekDays = GetWeekDays();

    // Список всех событий недели, отсортированных по времени (с учётом фильтра по категории)
    var weekEvents = VisibleEvents
        .Where(e => weekDays.Contains(e.StartDate.Date))
        .OrderBy(e => e.StartDate)
        .ToList();

    // Список строк: каждая строка – время и для каждого дня список событий, начинающихся в это время
    var rows = new List<(DateTime Time, Dictionary<DateTime, List<Event>> DayEvents)>();

    // 1) Строки по часам 8‑18
    for (int hour = 8; hour <= 18; hour++)
    {
        var time = new DateTime(CurrentDate.Year, CurrentDate.Month, CurrentDate.Day, hour, 0, 0);
        var dayEvents = weekDays.ToDictionary(
            d => d,
            d => weekEvents.Where(e => e.StartDate.Date == d.Date && e.StartDate.Hour == hour && e.StartDate.Minute == 0).ToList()
        );
        rows.Add((time, dayEvents));
    }

    // 2) Строки для событий, которые НЕ начинаются ровно в час
    var otherEvents = weekEvents
        .Where(e => e.StartDate.Minute != 0 || e.StartDate.Hour < 8 || e.StartDate.Hour > 18)
        .OrderBy(e => e.StartDate)
        .ToList();

    foreach (var ev in otherEvents)
    {
        var dayEvents = weekDays.ToDictionary(
            d => d,
            d => weekEvents.Where(e2 => e2.StartDate.Date == d.Date && e2.StartDate == ev.StartDate).ToList()
        );
        rows.Add((ev.StartDate, dayEvents));
    }

    // Сортируем строки по времени
    rows = rows.OrderBy(r => r.Time).ToList();
}
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" href="/">На главную</a>
            <button class="btn btn-primary" @onclick="() => OpenCreateDialog()">+ Добавить мероприятие</button>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                <CalendarNav />
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="badge bg-info text-dark">Режим: Неделя</span>
                    <select class="form-select form-select-sm" style="width: 240px;" @onchange="OnCategoryFilterChanged">
                        <option value="0" selected="@(SelectedCategoryFilter == 0)">Все категории</option>
                        @foreach (var category in Categories)
                        {
                            <option value="@category.Id" selected="@(SelectedCategoryFilter == category.Id)">@category.Name</option>
                        }
                    </select>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="PrevWeek">←</button>
                    <strong class="mx-2 text-capitalize">@GetWeekDays().First().ToString("dd MMM") — @GetWeekDays().Last().ToString("dd MMM")</strong>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="NextWeek">→</button>
                </div>
            </div>

            <div class="week-view table-responsive">
                <table class="table table-bordered align-middle text-center">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Время</th>
                            @foreach (var day in GetWeekDays())
                            {
                                <th class="@(IsHoliday(day) ? "table-warning" : string.Empty) ">
                                    <a class="btn btn-link p-0 text-start fw-bold text-decoration-none text-dark" href="/calendar/day?date=@day.ToString("yyyy-MM-dd")">
                                        @day.ToString("ddd, dd", new CultureInfo("ru-RU"))
                                    </a>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr>
                                <td class="fw-bold text-muted">@row.Time.ToString("HH:mm")</td>
                                @foreach (var day in GetWeekDays())
                                {
                                    var evs = row.DayEvents[day];
                                    <td class="week-cell p-1" style="min-width: 150px;">
                                        <!-- No placeholder for empty rows in week view -->
                                        @foreach (var evt in evs)
                                        {
                                            <a class="event-pill d-block w-100 text-start"
                                               style="border-left: 4px solid @GetCategoryColor(evt.CategoryId); text-decoration:none; color:inherit;"
                                               href="/event/@evt.Id">
                                                <small class="fw-bold d-block text-truncate">@evt.Title</small>
                                                <small class="text-muted">@evt.StartDate.ToString("HH:mm")</small>
                                            </a>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        <!-- Removed "Другие" row to avoid duplicate events -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (IsFormOpen)
{
    <div class="modal-backdrop show" @onclick="CloseForm"></div>
    <div class="modal d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(EditingEvent.Id > 0 ? "Редактирование мероприятия" : "Новое мероприятие")</h5>
                    <button type="button" class="btn-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Название мероприятия *</label>
                        <input class="form-control" @bind="EditingEvent.Title" placeholder="Согласно ТЗ" />
                    </div>
                    <div class="row g-2">
                        <div class="mb-3">
                            <label class="form-label">Начало</label>
                            <input class="form-control" type="datetime-local" @bind="EditingEvent.StartDate" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Окончание</label>
                            <input class="form-control" type="datetime-local" @bind="EditingEvent.EndDate" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Категория</label>
                            <select class="form-select" @bind="EditingEvent.CategoryId">
                                @foreach (var category in Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Место проведения</label>
                            <input class="form-control" @bind="EditingEvent.Location" placeholder="Например: Зал заседаний" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Организатор (Кто проводит)</label>
                            <input class="form-control" @bind="EditingEvent.Organizer" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Участники</label>
                            <input class="form-control" @bind="EditingEvent.Participants" placeholder="ФИО через запятую" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Дополнительная информация</label>
                        <textarea class="form-control" rows="3" @bind="EditingEvent.AdditionalInfo"></textarea>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(FormMessage))
                    {
                        <div class="alert alert-danger py-2">@FormMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    @if (EditingEvent.Id > 0)
                    {
                        <button class="btn btn-outline-danger me-auto" @onclick="DeleteCurrentEvent">Удалить</button>
                    }
                    <button class="btn btn-secondary" @onclick="CloseForm">Отмена</button>
                    <button class="btn btn-primary" @onclick="SaveEvent">Сохранить в план</button>
                </div>
            </div>
        </div>
    </div>
}

