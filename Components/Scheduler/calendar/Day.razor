@code {
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var qs = new Uri(Nav.Uri).Query;
        var q = System.Web.HttpUtility.ParseQueryString(qs);
        var dateStr = q.Get("date");
        if (!string.IsNullOrEmpty(dateStr) && DateTime.TryParse(dateStr, out var parsed))
        {
            CurrentDate = parsed.Date;
        }

        await LoadEventsForRange(CurrentDate.Date, CurrentDate.Date.AddDays(1).AddTicks(-1));
    }

    private async Task PrevDay()
    {
        CurrentDate = CurrentDate.AddDays(-1);
        await LoadEventsForRange(CurrentDate.Date, CurrentDate.Date.AddDays(1).AddTicks(-1));
        Nav.NavigateTo($"/calendar/day?date={CurrentDate:yyyy-MM-dd}", false);
    }

    private async Task NextDay()
    {
        CurrentDate = CurrentDate.AddDays(1);
        await LoadEventsForRange(CurrentDate.Date, CurrentDate.Date.AddDays(1).AddTicks(-1));
        Nav.NavigateTo($"/calendar/day?date={CurrentDate:yyyy-MM-dd}", false);
    }
}
