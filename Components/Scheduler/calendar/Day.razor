@page "/calendar/day"
@using Microsoft.AspNetCore.Components
@inject NavigationManager Nav
@inherits planirovanie.Components.Scheduler.CalendarBase

<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
       @{
    // Список событий текущего дня, отсортированный по времени
    var dayEvents = GetEventsForDaySorted(CurrentDate).ToList();

    // Список строк: каждая строка – время и список событий, начинающихся в это время
    var rows = new List<(DateTime Time, List<Event> Events)>();

    // 1) Строки по часам 8‑18 (с минутой 0)
    for (int hour = 8; hour <= 18; hour++)
    {
        var time = new DateTime(CurrentDate.Year, CurrentDate.Month, CurrentDate.Day, hour, 0, 0);
        var hourEvents = dayEvents.Where(e => e.StartDate.Hour == hour && e.StartDate.Minute == 0).ToList();
        rows.Add((time, hourEvents));
    }

    // 2) Строки для событий, которые НЕ начинаются ровно в час
    //    (или находятся до 8:00 / после 18:00)
    var otherEvents = dayEvents
        .Where(e => e.StartDate.Minute != 0 || e.StartDate.Hour < 8 || e.StartDate.Hour > 18)
        .OrderBy(e => e.StartDate)
        .ToList();

    foreach (var ev in otherEvents)
    {
        rows.Add((ev.StartDate, new List<Event> { ev }));
    }

    // Сортируем строки по времени
    rows = rows.OrderBy(r => r.Time).ToList();
}
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" href="/">На главную</a>
            <button class="btn btn-primary" @onclick="() => OpenCreateDialog()">+ Добавить мероприятие</button>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                <CalendarNav />
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="badge bg-info text-dark">Режим: День</span>
                    <select class="form-select form-select-sm" style="width: 240px;" @onchange="OnCategoryFilterChanged">
                        <option value="0" selected="@(SelectedCategoryFilter == 0)">Все категории</option>
                        @foreach (var category in Categories)
                        {
                            <option value="@category.Id" selected="@(SelectedCategoryFilter == category.Id)">@category.Name</option>
                        }
                    </select>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="PrevDay">←</button>
                    <strong class="mx-2 text-capitalize">@CurrentDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))</strong>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="NextDay">→</button>
                </div>
            </div>

            <div class="day-view">
                <div class="schedule-board">
                    @foreach (var row in rows)
                    {
                        <div class="schedule-row">
                            <button class="schedule-time btn btn-link p-0" style="background:none;border:none;padding:0;text-decoration:none;" type="button" @onclick="() => OpenCreateDialog(row.Time)">@row.Time.ToString("HH:mm")</button>
                            <div class="schedule-track">
                                @if (!row.Events.Any())
                                {
                                    <div class="text-muted small fst-italic ps-2 align-self-center">Нет мероприятий</div>
                                }
                                @foreach (var evt in row.Events)
                                {
                                    <a class="schedule-event"
                                       style="border-left: 6px solid @GetCategoryColor(evt.CategoryId); display:block; text-decoration:none; color:inherit;"
                                       href="/event/@evt.Id">
                                        <div class="fw-bold">@evt.Title</div>
                                        <div class="small text-muted">@evt.StartDate.ToString("HH:mm") — @evt.EndDate?.ToString("HH:mm")</div>
                                        @if (!string.IsNullOrEmpty(evt.Location))
                                        {
                                            <div class="small text-muted">📍 @evt.Location</div>
                                        }
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            </div>
        </div>
    </div>

@if (IsFormOpen)
{
    <div class="modal-backdrop show" @onclick="CloseForm"></div>
    <div class="modal d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(EditingEvent.Id > 0 ? "Редактирование мероприятия" : "Новое мероприятие")</h5>
                    <button type="button" class="btn-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Название мероприятия *</label>
                        <input class="form-control" @bind="EditingEvent.Title" placeholder="Согласно ТЗ" />
                    </div>
                    <div class="row g-2">
                        <div class="mb-3">
                            <label class="form-label">Начало</label>
                            <input class="form-control" type="datetime-local" @bind="EditingEvent.StartDate" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Окончание</label>
                            <input class="form-control" type="datetime-local" @bind="EditingEvent.EndDate" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Категория</label>
                            <select class="form-select" @bind="EditingEvent.CategoryId">
                                @foreach (var category in Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Место проведения</label>
                            <input class="form-control" @bind="EditingEvent.Location" placeholder="Например: Зал заседаний" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Организатор (Кто проводит)</label>
                            <input class="form-control" @bind="EditingEvent.Organizer" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Участники</label>
                            <input class="form-control" @bind="EditingEvent.Participants" placeholder="ФИО через запятую" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Дополнительная информация</label>
                        <textarea class="form-control" rows="3" @bind="EditingEvent.AdditionalInfo"></textarea>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(FormMessage))
                    {
                        <div class="alert alert-danger py-2">@FormMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    @if (EditingEvent.Id > 0)
                    {
                        <button class="btn btn-outline-danger me-auto" @onclick="DeleteCurrentEvent">Удалить</button>
                    }
                    <button class="btn btn-secondary" @onclick="CloseForm">Отмена</button>
                    <button class="btn btn-primary" @onclick="SaveEvent">Сохранить в план</button>
                </div>
            </div>
        </div>
    </div>
}

