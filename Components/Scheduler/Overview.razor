        private void OpenCreateDialog()
    {
        EditingEvent = new EventFormModel
        {
            StartDate = CurrentDate.Date.AddHours(9),
            EndDate = CurrentDate.Date.AddHours(10),
            CategoryId = Categories.FirstOrDefault()?.Id ?? 0
        };
        FormMessage = string.Empty;
        IsFormOpen = true;
    }

    private void OpenEditDialog(Event evt)
    {
        EditingEvent = new EventFormModel
        {
            Id = evt.Id,
            Title = evt.Title,
            StartDate = evt.StartDate,
            EndDate = evt.EndDate ?? evt.StartDate.AddHours(1),
            Location = evt.Location,
            Organizer = evt.Organizer,
            Participants = evt.Participants,
            AdditionalInfo = evt.AdditionalInfo,
            CategoryId = evt.CategoryId
        };
        FormMessage = string.Empty;
        IsFormOpen = true;
    }

    private void CloseForm()
    {
        IsFormOpen = false;
        EditingEvent = new EventFormModel();
        FormMessage = string.Empty;
    }

        private async Task SaveEvent()
    {
        if (string.IsNullOrWhiteSpace(EditingEvent.Title))
        {
            FormMessage = "Введите название мероприятия.";
            return;
        }

        // ✅ ИСПРАВЛЕНИЕ 1: Явная проверка, что дата начала выбрана
        if (!EditingEvent.StartDate.HasValue)
        {
            FormMessage = "Укажите дату и время начала мероприятия.";
            return;
        }

        // ✅ ИСПРАВЛЕНИЕ 2: Получаем чистый DateTime через .Value
        var start = EditingEvent.StartDate.Value; 
        
        // Теперь start - это обычный DateTime, и метод AddHours работает корректно
        var end = EditingEvent.EndDate ?? start.AddHours(1); 

        if (end <= start)
        {
            FormMessage = "Время окончания должно быть позже времени начала.";
            return;
        }

        var entity = new Event
        {
            Id = EditingEvent.Id,
            Title = EditingEvent.Title,
            StartDate = start, // ✅ ИСПРАВЛЕНИЕ 3: Передаем уже проверенный start без .Value
            EndDate = end,
            Location = EditingEvent.Location,
            Organizer = EditingEvent.Organizer,
            Participants = EditingEvent.Participants,
            AdditionalInfo = EditingEvent.AdditionalInfo,
            CategoryId = EditingEvent.CategoryId
        };

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.Identity?.Name ?? "system";

        try
        {
            if (EditingEvent.Id > 0)
            {
                await EventService.UpdateEventAsync(entity, userId);
            }
            else
            {
                entity.CreatedAt = DateTime.UtcNow;
                entity.CreatedByUserId = userId;
                await EventService.AddEventAsync(entity, userId);
            }

            CloseForm();
            await LoadEventsAsync();
        }
        catch (Exception ex)
        {
            FormMessage = $"Ошибка сохранения: {ex.Message}";
        }
    }

    private async Task DeleteCurrentEvent()
    {
        if (EditingEvent.Id > 0)
        {
            await EventService.DeleteEventAsync(EditingEvent.Id);
            CloseForm();
            await LoadEventsAsync();
        }
    }

    // ✅ ИСПРАВЛЕННАЯ И ПОЛНАЯ МОДЕЛЬ (добавлены отсутствующие свойства, используемые в SaveEvent)
    public class EventFormModel
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Location { get; set; } = string.Empty;
        public string Organizer { get; set; } = string.Empty;
        public string Participants { get; set; } = string.Empty;
        public string AdditionalInfo { get; set; } = string.Empty;
        public int CategoryId { get; set; }

        // Используем DateTime? для прямой и безопасной привязки к <input type="datetime-local">
        public DateTime? StartDate { get; set; }
        public DateTime? EndDate { get; set; }

        public bool IsAllDay { get; set; }
    }
}