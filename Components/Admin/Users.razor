@page "/admin/users"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using planirovanie.Data
@using planirovanie.Models
@using planirovanie.Components.Scheduler
@attribute [Authorize(Roles = "Administrator")]
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager

<PageTitle>Управление пользователями</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Управление пользователями</h2>
    <button class="btn btn-primary" @onclick="ShowCreateDialog">
        <i class="bi bi-plus"></i> Добавить пользователя
    </button>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-@(messageType)">@message</div>
}

<div class="card">
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Email</th>
                    <th>Юзернейм</th>
                    <th>ФИО</th>
                    <th>Должность</th>
                    <th>Телефон</th>
                    <th>Роль</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>@user.UserName</td>
                        <td>@(string.IsNullOrEmpty(user.FullName) ? "—" : user.FullName)</td>
                        <td>@(string.IsNullOrEmpty(user.Position) ? "—" : user.Position)</td>
                        <td>@(string.IsNullOrEmpty(user.PhoneNumber) ? "—" : user.PhoneNumber)</td>
                        <td>
                            @foreach (var role in userRoles[user.Id])
                            {
                                <span class="badge bg-info">@role</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditUser(user.Id)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            @if (user.Email != "admin@volgodonsk.local")
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteUser(user.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (showDialog)
{
    <div class="modal-backdrop show"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingUserId == null ? "Новый пользователь" : "Редактирование пользователя")</h5>
                    <button type="button" class="btn-close" @onclick="CloseDialog"></button>
                </div>
                <div class="modal-body">
                    @if (editingUserId == null)
                    {
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input type="checkbox" class="form-check-input" @bind="isGuestAccount" id="guestSwitch" />
                                <label class="form-check-label" for="guestSwitch">
                                    <strong>Гостевой аккаунт</strong>
                                </label>
                            </div>
                        </div>

                        @* Поля-приманки: перехватывают автозаполнение браузера *@
                        <div style="position:absolute; left:-9999px; top:-9999px;" aria-hidden="true">
                            <input type="text" name="fakeuser" autocomplete="username" tabindex="-1" />
                            <input type="email" name="fakeemail" autocomplete="email" tabindex="-1" />
                            <input type="tel" name="fakephone" autocomplete="tel" tabindex="-1" />
                            <input type="password" name="fakepass" autocomplete="current-password" tabindex="-1" />
                        </div>
                    }

                    @if (!isGuestAccount || editingUserId != null)
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control" @bind="newUserEmail" autocomplete="off" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Юзернейм</label>
                                    <input type="text" class="form-control" @bind="newUserName" autocomplete="off" />
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">ФИО</label>
                                <input type="text" class="form-control" @bind="newUserFullName" placeholder="Иван Иванов" autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Должность</label>
                                <input type="text" class="form-control" @bind="newUserPosition" placeholder="Специалист" autocomplete="off" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Телефон</label>
                                <input type="tel" class="form-control" @bind="newUserPhone" placeholder="+7 (XXX) XXX-XX-XX" autocomplete="off" />
                            </div>
                        </div>
                        @if (!isGuestAccount || editingUserId != null)
                        {
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Роль</label>
                                    <select class="form-select" @bind="newUserRole">
                                        <option value="User">Исполнитель (User)</option>
                                        <option value="Executor">Ответственный (Executor)</option>
                                        <option value="Administrator">Администратор (Administrator)</option>
                                    </select>
                                </div>
                            </div>
                        }
                    </div>

                    @if (!isGuestAccount || editingUserId != null)
                    {
                        @if (editingUserId == null)
                        {
                            <div class="mb-3">
                                <label class="form-label">Пароль <span class="text-danger">*</span></label>
                                <input type="password" class="form-control" @bind="newUserPassword" autocomplete="new-password" />
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label">Изменить пароль (оставить пусто если не менять)</label>
                                <input type="password" class="form-control" @bind="newUserPassword" autocomplete="new-password" />
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDialog">Отмена</button>
                    <button class="btn btn-primary" @onclick="SaveUser">Сохранить</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 1040;
    }
    .modal {
        position: fixed;
        inset: 0;
        z-index: 1050;
        overflow-y: auto;
    }
</style>

@code {
    private List<ApplicationUser> users = new();
    private Dictionary<string, List<string>> userRoles = new();
    private bool showDialog;
    private string? editingUserId;
    private string newUserEmail = string.Empty;
    private string newUserName = string.Empty;
    private string newUserPassword = string.Empty;
    private string newUserRole = "User";
    private string? newUserFullName = null;
    private string? newUserPosition = null;
    private string? newUserPhone = null;
    private string message = string.Empty;
    private string messageType = "info";
    private bool isGuestAccount = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        users = await DbContext.Users.AsNoTracking().ToListAsync();
        userRoles.Clear();
        
        foreach (var user in users)
        {
            var roles = await UserManager.GetRolesAsync(user);
            userRoles[user.Id] = roles.ToList();
        }
    }

    private void ShowCreateDialog()
    {
        editingUserId = null;
        newUserEmail = string.Empty;
        newUserName = string.Empty;
        newUserPassword = string.Empty;
        newUserFullName = null;
        newUserPosition = null;
        newUserPhone = null;
        newUserRole = "User";
        isGuestAccount = false;
        showDialog = true;
    }

    private async Task EditUser(string userId)
    {
        var user = await UserManager.FindByIdAsync(userId);
        if (user != null)
        {
            editingUserId = userId;
            newUserEmail = user.Email ?? string.Empty;
            newUserName = user.UserName ?? string.Empty;
            newUserFullName = user.FullName;
            newUserPosition = user.Position;
            newUserPhone = user.PhoneNumber;
            newUserPassword = string.Empty;
            var roles = await UserManager.GetRolesAsync(user);
            newUserRole = roles.FirstOrDefault() ?? "User";
            showDialog = true;
        }
    }

    private async Task SaveUser()
    {
        try
        {
            if (editingUserId == null)
            {
                ApplicationUser user;
                string passwordToUse;
                
                if (isGuestAccount)
                {
                    if (string.IsNullOrWhiteSpace(newUserFullName))
                    {
                        message = "ФИО обязательно для гостевого аккаунта";
                        messageType = "danger";
                        return;
                    }
                    
                    var generatedUserName = GenerateGuestUserName(newUserFullName);
                    user = new ApplicationUser
                    {
                        UserName = generatedUserName,
                        Email = $"guest{new Random().Next(1000, 9999)}@guest.local",
                        FullName = newUserFullName,
                        Position = newUserPosition,
                        PhoneNumber = newUserPhone
                    };
                    passwordToUse = Guid.NewGuid().ToString("N").Substring(0, 8);
                    newUserRole = "User";
                }
                else
                {
                    if (string.IsNullOrWhiteSpace(newUserEmail) || string.IsNullOrWhiteSpace(newUserPassword))
                    {
                        message = "Email и пароль обязательны";
                        messageType = "danger";
                        return;
                    }
                    
                    user = new ApplicationUser
                    {
                        UserName = string.IsNullOrEmpty(newUserName) ? newUserEmail.Split('@')[0] : newUserName,
                        Email = newUserEmail,
                        FullName = newUserFullName,
                        Position = newUserPosition,
                        PhoneNumber = newUserPhone
                    };
                    passwordToUse = newUserPassword;
                }

                var result = await UserManager.CreateAsync(user, passwordToUse);
                if (result.Succeeded)
                {
                    await UserManager.AddToRoleAsync(user, newUserRole);
                    message = isGuestAccount 
                        ? "Гостевой аккаунт создан" 
                        : "Пользователь успешно создан";
                    messageType = "success";
                }
                else
                {
                    message = string.Join(", ", result.Errors.Select(e => e.Description));
                    messageType = "danger";
                    return;
                }
            }
            else
            {
                var user = await UserManager.FindByIdAsync(editingUserId);
                if (user != null)
                {
                    user.Email = newUserEmail;
                    user.UserName = string.IsNullOrEmpty(newUserName) ? newUserEmail.Split('@')[0] : newUserName;
                    user.FullName = newUserFullName;
                    user.Position = newUserPosition;
                    user.PhoneNumber = newUserPhone;
                    await UserManager.UpdateAsync(user);
                    
                    var currentRoles = await UserManager.GetRolesAsync(user);
                    await UserManager.RemoveFromRolesAsync(user, currentRoles);
                    await UserManager.AddToRoleAsync(user, newUserRole);
                    
                    if (!string.IsNullOrEmpty(newUserPassword))
                    {
                        await UserManager.RemovePasswordAsync(user);
                        await UserManager.AddPasswordAsync(user, newUserPassword);
                    }
                    
                    message = "Пользователь обновлен";
                    messageType = "success";
                }
            }
            
            CloseDialog();
            await LoadUsersAsync();
            CalendarBase.InvalidateUserCache();
        }
        catch (Exception ex)
        {
            message = $"Ошибка: {ex.Message}";
            messageType = "danger";
        }
    }

    private async Task DeleteUser(string userId)
    {
        var user = await UserManager.FindByIdAsync(userId);
        if (user != null)
        {
            await UserManager.DeleteAsync(user);
            message = "Пользователь удален";
            messageType = "success";
            await LoadUsersAsync();

            // Очищаем кэш пользователей для всех сеансов
            CalendarBase.InvalidateUserCache();
        }
    }

    private void CloseDialog()
    {
        showDialog = false;
        isGuestAccount = false;
    }

    private string GenerateGuestUserName(string fullName)
    {
        var translitMap = new Dictionary<char, string>
        {
            {'а', "a"}, {'б', "b"}, {'в', "v"}, {'г', "g"}, {'д', "d"},
            {'е', "e"}, {'ё', "e"}, {'ж', "zh"}, {'з', "z"}, {'и', "i"},
            {'й', "y"}, {'к', "k"}, {'л', "l"}, {'м', "m"}, {'н', "n"},
            {'о', "o"}, {'п', "p"}, {'р', "r"}, {'с', "s"}, {'т', "t"},
            {'у', "u"}, {'ф', "f"}, {'х', "h"}, {'ц', "ts"}, {'ч', "ch"},
            {'ш', "sh"}, {'щ', "sch"}, {'ъ', ""}, {'ы', "y"}, {'ь', ""},
            {'э', "e"}, {'ю', "yu"}, {'я', "ya"}
        };
        
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var initials = "";
        
        if (parts.Length >= 2)
        {
            var firstLetter = char.ToLower(parts[0][0]);
            var secondLetter = char.ToLower(parts[1][0]);
            
            initials = translitMap.ContainsKey(firstLetter) ? translitMap[firstLetter] : firstLetter.ToString();
            initials += translitMap.ContainsKey(secondLetter) ? translitMap[secondLetter] : secondLetter.ToString();
        }
        else if (parts.Length == 1 && parts[0].Length > 0)
        {
            var firstLetter = char.ToLower(parts[0][0]);
            initials = translitMap.ContainsKey(firstLetter) ? translitMap[firstLetter] : firstLetter.ToString();
        }
        
        var random = new Random();
        return $"{initials}{random.Next(1000, 9999)}";
    }
}