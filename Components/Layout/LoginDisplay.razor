@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
        <div class="text-end">
            <span class="text-muted me-2">Здравствуйте, @context.User.Identity?.Name!</span>
            <a href="/Logout" class="btn btn-sm btn-outline-danger" rel="external">Выйти</a>
        </div>
    </Authorized>
    <NotAuthorized>
        @* Показываем кнопку "Войти" только если мы НЕ на странице /login *@
        @if (!Nav.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase))
        {
            <div class="text-end">
                <a href="/Login" class="btn btn-sm btn-primary">Войти в систему</a>
            </div>
        }
    </NotAuthorized>
</AuthorizeView>