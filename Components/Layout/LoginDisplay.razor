@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using planirovanie.Models
@inject NavigationManager Nav
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<AuthorizeView>
    <Authorized>
        <div class="text-end">
            <span class="text-muted me-2">Здравствуйте, @DisplayName!</span>
            <a href="/Logout" class="btn btn-sm btn-outline-danger" rel="external">Выйти</a>
        </div>
    </Authorized>
    <NotAuthorized>
        @* Показываем кнопку "Войти" только если мы НЕ на странице /login *@
        @if (!Nav.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase))
        {
            <div class="text-end">
                <a href="/Login" class="btn btn-sm btn-primary">Войти в систему</a>
            </div>
        }
    </NotAuthorized>
</AuthorizeView>

@code {
    private string DisplayName = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        var login = (await AuthStateProvider.GetAuthenticationStateAsync())?.User?.Identity?.Name;
        if (!string.IsNullOrEmpty(login))
        {
            // Identity.Name — это UserName; ищем по нему, а если вдруг это email — по email
            var user = login.Contains('@')
                ? await UserManager.FindByEmailAsync(login)
                : await UserManager.FindByNameAsync(login);
            DisplayName = !string.IsNullOrWhiteSpace(user?.FullName)
                ? user!.FullName
                : (user?.UserName ?? login);
        }
    }
}