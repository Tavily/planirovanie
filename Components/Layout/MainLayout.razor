@inherits LayoutComponentBase
@inject NavigationManager Nav

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center gap-3">
            @if (IsCalendarPage)
            {
                <div class="overflow-hidden me-auto">
                    <h2 class="mb-0" style="font-size: 1.25rem;">Календарь мероприятий</h2>
                    <div class="text-muted small text-truncate">План основных мероприятий, проводимых на территории муниципального образования "Город Волгодонск"</div>
                </div>
            }
            else if (IsEventDetailsPage)
            {
                <div class="me-auto">
                    <h2 class="mb-0 fw-bold" style="font-size: 1.25rem;">Информация о мероприятии</h2>
                </div>
            }
            else
            {
                <div class="me-auto">
                    <h2 class="mb-0" style="font-size: 1.25rem;">Электронная система планирования</h2>
                </div>
            }
            <div class="ms-auto">
                <LoginDisplay />
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool IsEventDetailsPage =>
        Nav.Uri.Contains("/events/", StringComparison.OrdinalIgnoreCase);
    private bool IsCalendarPage =>
        Nav.Uri.Contains("/calendar", StringComparison.OrdinalIgnoreCase) ||
        Nav.Uri.Contains("/events", StringComparison.OrdinalIgnoreCase);
}