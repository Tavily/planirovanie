@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using planirovanie.Components.Scheduler
@inject IJSRuntime JS
@attribute [Authorize]

<PageTitle>Система планирования мероприятий</PageTitle>

<div class="container mt-4">
    @* <h2>Электронная система планирования мероприятий</h2> *@

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <a href="/calendar/day" class="btn btn-primary">Перейти к календарю мероприятий</a>
                    <button class="btn btn-outline-primary ms-2" @onclick="() => IsUserSearchOpen = true">
                        Найти план-сетку пользователя
                    </button>
                </div>
            </div>
        </div>

    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <PersonalSchedule />
        </div>
    </div>

    @if (IsUserSearchOpen)
    {
        <UserSearchModal IsOpen="true"
                         OnClose="CloseUserSearch"
                         OnUserSelected="OpenUserSchedule" />
    }

</div>

@code {
    private bool IsUserSearchOpen { get; set; }

    private void CloseUserSearch() => IsUserSearchOpen = false;

    private async Task OpenUserSchedule(ApplicationUser user)
    {
        IsUserSearchOpen = false;
        var url = $"/schedule/{Uri.EscapeDataString(user.Id)}";
        await JS.InvokeVoidAsync("window.open", url, "_blank");
    }
}