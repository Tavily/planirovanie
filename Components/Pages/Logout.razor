@* This component is kept for UI layout only. The actual /Logout route is handled by pages/Logout.cshtml *@
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using planirovanie.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager

<PageTitle>Выход из системы</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-5 text-center">
                    <h2 class="card-title mb-4">Выход из системы</h2>
                    <p class="text-muted">Пожалуйста, подождите...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await SignInManager.SignOutAsync();
            // Задержка для гарантии завершения выхода
            await Task.Delay(500);
            // Навигация через InvokeAsync и с forceLoad, чтобы выполнение было в UI-контексте
            await InvokeAsync(() => NavigationManager.NavigateTo("/Login", forceLoad: true));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при выходе: {ex.Message}");
            await InvokeAsync(() => NavigationManager.NavigateTo("/Login", forceLoad: true));
        }
    }
}